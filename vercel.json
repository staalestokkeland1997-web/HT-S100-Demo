{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/", "destination": "/app.html" },
    { "source": "/proxy", "destination": "/api/proxy" },
    { "source": "/ais/:path*", "destination": "/api/ais?sub=:path*" },
    { "source": "/api/ais/:path*", "destination": "/api/ais?sub=:path*" },
    { "source": "/api/admin/:path*", "destination": "/api/admin?sub=:path*" },
    { "source": "/favicon.ico", "destination": "/assets/logo.svg" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(html|js|css|json|svg|webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|ico|woff|woff2|txt)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ],
  "functions": {
    "api/[[...path]].js": {
      "maxDuration": 30
    }
  }
}
